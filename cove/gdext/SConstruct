#!/usr/bin/env python
# Build the cove GDExtension (IOSurface -> Metal -> Texture2DRD).
# Requires godot-cpp checked out at /tmp/godot-cpp (see cove/README.md).
import os
from SCons.Script import ARGUMENTS

# Pin a universal build so the dylib name is deterministic and always matches
# the path in cove.gdextension (a host-arch build would produce e.g. .arm64 and
# silently fail to load). Override with `scons arch=...` if you really need to.
ARGUMENTS.setdefault("arch", "universal")

env = SConscript("/tmp/godot-cpp/SConstruct")

env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp") + Glob("src/*.mm")

# Apple frameworks for Metal + IOSurface interop, plus AppKit for the native
# termling drag-and-drop (CoveDrag).
env.Append(LINKFLAGS=[
    "-framework", "Metal",
    "-framework", "IOSurface",
    "-framework", "Foundation",
    "-framework", "QuartzCore",
    "-framework", "AppKit",
    "-framework", "CoreGraphics",
])
# .mm files are Objective-C++.
env.Append(CXXFLAGS=["-ObjC++"])

libname = "libcove{}{}".format(env["suffix"], env["SHLIBSUFFIX"])
library = env.SharedLibrary("../bin/" + libname, source=sources)
Default(library)
