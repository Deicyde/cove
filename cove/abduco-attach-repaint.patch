+				 * server only resends the same size, which TUIs ignore, so a
+				 * reattached idle agent stayed blank until you typed into it. */
+				static bool pulsed = false;
+				if (!pulsed && ws.ws_row > 2) {
+					struct winsize small = ws;
+					small.ws_row -= 1;
